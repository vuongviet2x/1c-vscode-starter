scripts\windows\restore-dt.cmd# Cấu hình kết nối 1C cho các script trong thư mục scripts/
# Sao chép file này thành 1c.env rồi sửa. File 1c.env không được đưa lên Git.
# Quy tắc: mỗi dòng KEY=VALUE, KHÔNG để dấu cách quanh dấu =, KHÔNG dùng dấu ngoặc kép.

# Phiên bản platform đã cài (khóa học dùng 8.3.25.1445)
V8_VERSION=8.3.25.1445

# Đường dẫn đầy đủ tới 1cv8 (Designer). Để trống để script tự tìm theo V8_VERSION.
#   Windows: C:\Program Files\1cv8\8.3.25.1445\bin\1cv8.exe
#   macOS:   /Applications/1cv8.localized/8.3.25.1445/1cv8.app/Contents/MacOS/1cv8
V8_PATH=

# Thư mục infobase dạng file. Đường dẫn tương đối tính từ thư mục dự án.
IB_PATH=ib

# Tài khoản đăng nhập infobase (để trống nếu infobase chưa có user)
IB_USER=
IB_PWD=

# Ngôn ngữ giao diện platform khi chạy script: en hoặc ru. Thông báo lỗi sẽ theo ngôn ngữ này.
UI_LANG=en
