# Cấu hình kết nối 1C cho các script trong thư mục scripts/
# Sao chép file này thành 1c.env rồi sửa. File 1c.env không được đưa lên Git.
# Quy tắc: mỗi dòng KEY=VALUE, KHÔNG để dấu cách quanh dấu =, KHÔNG dùng dấu ngoặc kép.

# Phiên bản platform muốn dùng. ĐỂ TRỐNG = script tự chọn bản mới nhất đã cài trên máy.
#   Ghi một phần để chọn bản mới nhất trong dòng đó, ví dụ: 8.3.25  (mọi bản 8.3.25.x)
#   Ghi đầy đủ để dùng đúng một bản, ví dụ: 8.3.25.1445
#   Lộ trình 1C:Jet của khóa: đặt V8_VERSION=8.3.25 (cấu hình Jet chạy trên bản này).
V8_VERSION=

# Đường dẫn đầy đủ tới 1cv8 (Designer). Để trống để script tự tìm theo V8_VERSION.
# Chỉ cần điền khi platform cài ở chỗ lạ (script tìm sẵn trong Program Files, Program Files (x86), bản training 1cv8t).
#   Windows: C:\Program Files\1cv8\8.3.25.1445\bin\1cv8.exe
#   macOS:   /Applications/1cv8.localized/8.3.25.1445/1cv8.app/Contents/MacOS/1cv8
V8_PATH=

# Thư mục infobase dạng file. Đường dẫn tương đối tính từ thư mục dự án.
IB_PATH=ib

# Tài khoản đăng nhập infobase (để trống nếu infobase chưa có user)
IB_USER=
IB_PWD=

# Đặt =1 chỉ khi bạn chắc chắn muốn dump bằng platform khác phiên bản chung của nhóm (.1c-platform)
ALLOW_PLATFORM_MISMATCH=

# Ngôn ngữ giao diện platform khi chạy script: en hoặc ru. Thông báo lỗi sẽ theo ngôn ngữ này.
UI_LANG=en
